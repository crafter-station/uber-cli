{
  "name": "@crafter/uber-cli",
  "version": "0.1.0",
  "description": "Agent-first CLI and MCP server for Uber: rides, fares, trips, receipts and Eats, with Keychain sessions and a confirm ladder for anything that costs money",
  "type": "module",
  "license": "MIT",
  "author": "Cristian Correa",
  "bin": {
    "uber": "./bin/uber.js"
  },
  "files": [
    "dist",
    "bin",
    "skills",
    "README.md"
  ],
  "scripts": {
    "dev": "bun src/cli.ts",
    "build": "bun build src/main.ts --target=node --outdir dist --format esm --minify",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "sync:operations": "bun scripts/sync-operations.ts",
    "prepublishOnly": "bun run typecheck && bun test && bun run build",
    "logo": "bun scripts/build-logo.ts",
    "demo": "vhs assets/demo.tape"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "uber",
    "rides",
    "ubereats",
    "cli",
    "mcp",
    "agent",
    "agent-browser",
    "claude"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "pbf": "^5.1.2",
    "picocolors": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crafter-station/uber-cli.git"
  }
}
